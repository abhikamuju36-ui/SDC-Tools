# SDC Tools Electron shell — environment configuration.
# Copy to `.env` and fill in the values you need.

# Azure AD (Entra ID) app registration used for the "Sign in with Microsoft"
# login (MSAL, Authorization Code + PKCE via loopback redirect — see
# electron/auth.js). Single-tenant, @sdcautomation.com accounts only (the
# domain check happens in code, not via Conditional Access).
# Leave both blank to run in "Dev Mode": the launcher UI authenticates
# locally with a fake identity, but NOTHING is propagated to any sub-app —
# every one of them stays exactly as unauthenticated as it is without this
# feature. Useful for UI development; not a substitute for testing the real
# SSO chain, which needs a real tenant/client id.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Hostname the 5 sub-apps and Reports are reached at — must match wherever
# they're actually running (PM2 on the real deployment, localhost for local
# dev against locally-run sub-apps).
SDC_SERVER_HOST=localhost
