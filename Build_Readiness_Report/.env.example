# ETO Database (SQL Server)
ETO_HOST=your-server-here
ETO_DATABASE=your-database-here
ETO_USER=your-user-here
ETO_PASSWORD=your-password-here

# SDC Scheduler — source of build-start/ship dates. MUST match the same
# READINESS_SHARED_TOKEN value in SDC_Scheduler/.env.
SCHEDULER_URL=http://localhost:4003
READINESS_SHARED_TOKEN=change-this-to-a-random-64-char-string

# App
PORT=3000
