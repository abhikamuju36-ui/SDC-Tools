# Build Readiness Report — environment variable template
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── Required ─────────────────────────────────────────────────────────────────
# ETO SQL Server (MSSQL) connection — read-only account recommended
ETO_HOST=your-sql-server-hostname
ETO_DATABASE=your-database-name
ETO_USER=your-sql-user
ETO_PASSWORD=your-sql-password

# ── Optional ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3000; shell uses 4002)
PORT=3000

# Set to 'production' on the server; 'development' locally
NODE_ENV=development

# ── Smartsheet (optional — for build-date overlays) ──────────────────────────
# SMARTSHEET_API_KEY=your_api_key_here

# ── Email reports (optional) ──────────────────────────────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@sdcautomation.com
# SMTP_PASSWORD=your-smtp-password
