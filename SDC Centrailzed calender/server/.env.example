# Azure AD App Registration
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Server config
SERVER_IP=localhost
PORT=3001

# Frontend URL
FRONTEND_URL=http://localhost:3000
WEB_PORT=3000

# JWT signing secret — use a long random string
JWT_SECRET=change-this-to-a-long-random-secret

# Session secret — use a different long random string
SESSION_SECRET=change-this-to-another-long-random-secret

# ── Azure SQL Database ─────────────────────────────────────────────────────
# Find these in Azure Portal → SQL Server → Connection strings
AZURE_SQL_SERVER=yourserver.database.windows.net
AZURE_SQL_DATABASE=sdc-tools
AZURE_SQL_USER=your-sql-username
AZURE_SQL_PASSWORD=your-sql-password
# AZURE_SQL_PORT=1433  (optional — default is 1433)
