# Server config
SERVER_IP=localhost
PORT=4005

# Frontend URL
FRONTEND_URL=http://localhost:4005
ALLOWED_ORIGINS=http://localhost:4005

# Auth bypass — set true when running via the SDC shell launcher
SKIP_AUTH=false

# JWT signing secret — use a long random string
JWT_SECRET=change-this-to-a-long-random-secret

# Session secret — use a different long random string
SESSION_SECRET=change-this-to-another-long-random-secret

# ── MySQL Database ─────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=sdc_calendar

# ── Optional integrations ──────────────────────────────────────────────────
# Smartsheet API token (read-only sheet sync)
SMARTSHEET_API_TOKEN=

# Teams webhook for event notifications (optional)
TEAMS_WEBHOOK_URL=
