# SDC State Logic Builder — environment configuration.
# Copy to `.env` and fill in the values you need.

PORT=4004

# Standards library path — must match the path PM2's ecosystem.config.js sets
# for this app in production; keep the two in sync.
STANDARDS_DIR=N:\AI Folder\State Logic Diagrams\standards

# MySQL storage. Same local server as the other SDC Tools apps.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sdc_statelogic

# ─── SDC Tools centralized session (SSO) ─────────────────────────────────
# Shared secret used to verify the "sdc_session" cookie minted by SDC
# Scheduler's central SSO after the SDC Tools shell's Azure AD login. Same
# value must be set on every SDC Tools app (Scheduler, Assemblies Library,
# Build Readiness Report, State Logic Builder, Calendar). Do not invent a
# value here — get the real one from wherever the other apps' secrets live.
SDC_SESSION_SECRET=

# Set to 'true' to require a valid sdc_session cookie on every route except
# /health. Defaults to unset/false — no behavior change until explicitly
# enabled here.
SDC_SSO_ENABLED=false

# ─── Jarvis AI generation (agentGenerator) ───────────────────────────────
# Required for /api/generate, /api/generate/stream, /api/jarvis/diagram and
# /api/jarvis/spec. Without it those four routes return 503 and the rest of
# the app works normally.
ANTHROPIC_API_KEY=
