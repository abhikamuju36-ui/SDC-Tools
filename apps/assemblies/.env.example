# ─────────────────────────────────────────────────────────────────────────────
# SDC Assemblies Library — Environment Configuration Template
# Copy this file to .env and fill in the values.
# The .env file is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (default: 4001 — assigned in SDC Tools shell)
PORT=4001

# Network drive paths (default shown — override if your drives are mapped differently)
DRIVE_N=N:/
DRIVE_L=L:/

# Shared network folder where the database and thumbnails are stored.
# All users must point to the SAME path so they share data.
# If this path is unavailable the app falls back to a local folder (read the startup log).
SHARED_BASE=N:/_Assembilies_Library_Application

# Password required to delete records.
# Set a strong value — this is the only auth on destructive operations.
DELETE_PASSWORD=change_me_to_something_strong

# CORS origin — restrict to exactly the Electron app URL in production.
# Use * only during development.
ALLOWED_ORIGIN=http://127.0.0.1:4001

# Set to 'true' to enable verbose SQL and request logging.
# DEBUG=true

# ── MySQL (local) ─────────────────────────────────────────────────────────────
# Migrated off Azure SQL 2026-06-09 — see server/services/db.service.js.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=sdc_assemblies

# ─── SDC Tools centralized session (SSO) ─────────────────────────────────────
# Shared secret used to verify the "sdc_session" cookie minted by SDC
# Scheduler's central SSO after the SDC Tools shell's Azure AD login.
# Same value must be set on every SDC Tools app (Assemblies Library, Build
# Readiness Report, State Logic Builder, Calendar, Scheduler). Do not invent
# a value here — get the real one from wherever the other apps' secrets live.
# SDC_SESSION_SECRET=

# Set to 'true' to require a valid sdc_session cookie on every route except
# /health. Defaults to unset/false — no behavior change until explicitly
# enabled here.
# SDC_SSO_ENABLED=true
