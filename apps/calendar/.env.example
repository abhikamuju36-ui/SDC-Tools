# SDC Calendar — environment configuration.
# Copy to .env (at this app's ROOT — not server/) and fill in real values.
# PM2 sets cwd here, so this is the file dotenv actually loads in production.
# (server/.env.example documents a larger, partly-legacy set for the
# standalone-Electron-desktop build path — this file matches what's live.)

# Server config
SERVER_IP=localhost
PORT=4005

# Frontend URL
FRONTEND_URL=http://localhost:4005
ALLOWED_ORIGINS=http://localhost:4005

# ─── SDC Tools centralized session (SSO) ─────────────────────────────────
# Shared secret used to verify the "sdc_session" cookie minted by SDC
# Scheduler's central SSO after the SDC Tools shell's Azure AD login (see
# server/middleware/requireAuth.js). Same value must be set on every SDC
# Tools app (Scheduler, Assemblies Library, Build Readiness Report, State
# Logic Builder, Calendar). Do not invent a value here — get the real one
# from wherever the other apps' secrets live.
SDC_SESSION_SECRET=

# Legacy flag — no longer bypasses authentication (that hardcoded-admin path
# was removed 2026-08-20). Only still skips setting up express-session, which
# the unused standalone Azure OAuth sign-in flow (server/auth.js) needs.
# Harmless either way; production sets this to 'true'.
SKIP_AUTH=false

# ── MySQL Database ─────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=sdc_calendar

# ── Optional integrations ──────────────────────────────────────────────────
# Smartsheet API token (read-only sheet sync)
SMARTSHEET_API_TOKEN=
