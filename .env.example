# ── SDC Tools centralized login — shared across Scheduler, Assemblies
#    Library, Build Readiness Report, State Logic Builder, Calendar ─────────
# Same secret value in ALL FOUR of those apps' own .env files (Scheduler
# mints sessions with it via routes/ssoCentral.js; the other three only
# verify). SDC_SSO_ENABLED defaults off/unset in every app — no behavior
# change until deliberately set to 'true' per app.
SDC_SESSION_SECRET=your_shared_sso_secret
# SDC_SSO_ENABLED=true

# ── Shell / Electron (apps/shell/.env) ────────────────────────────────────────
SDC_SERVER_HOST=SERVER-APP1
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id

# ── Build Readiness Report (apps/build-readiness/.env) ────────────────────────
# ETO on-prem SQL Server (required)
ETO_HOST=SERVER-APP1.stevendouglas.local
ETO_DATABASE=SDC
ETO_USER=your_user
ETO_PASSWORD=your_password
ETO_DOMAIN=stevendouglas
ETO_PORT=1433
PORT=3000
# Smartsheet integration was removed (2026-08) — build-start/ship dates now
# come from SDC Scheduler's own integration API. See SCHEDULER_URL /
# READINESS_SHARED_TOKEN in apps/build-readiness/.env.example instead.

# ── SDC Scheduler (SDC_Scheduler/.env — not moved, own repo) ──────────────────
# See SDC_Scheduler/.env.example for its full var set (MySQL, ETO, Anthropic,
# Power BI bridge, centralized-login broker). Not duplicated here.

# ── State Logic Builder (apps/state-logic/.env) ───────────────────────────────
STANDARDS_DIR=N:\AI Folder\State Logic Diagrams\standards

# ── SDC Calendar (apps/calendar/.env) ─────────────────────────────────────────
FRONTEND_URL=http://SERVER-APP1:4005
SERVER_IP=SERVER-APP1

# ── Assemblies Library (apps/assemblies/.env) ─────────────────────────────────
SHARED_BASE=\\stevendouglas.local\dfs\Company\Job Folder\_Assembilies_Library_Application
DELETE_PASSWORD=your_delete_password
