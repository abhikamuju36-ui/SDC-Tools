dist/
client/dist/

# Local environment files
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Project specific
netstat.txt
tmp/
.claude/

# C# build output (all projects)
**/bin/
**/obj/
**/*.user

# SolidWorks scanner — generated data files and scratch
Solidworks_Azure/Solidworks_Assemblies_CSV_Output/
Solidworks_Azure/scratch/
Solidworks_Azure/build.log

# Temporary / unrelated directories
tmp_schema/
other_projects/

# Generated thumbnails (large binary files — regenerate with sync-thumbnails.js)
thumbnails/
thumbnail-test-output/

# Database (large generated file — lives on server only)
database.csv

# Electron builder output
dist-build/
dist-electron/
