# ─────────────────────────────────────────────────────────────────────────────
# SDC Assemblies Library — Environment Configuration Template
# Copy this file to .env and fill in the values.
# The .env file is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (default: 3001)
PORT=3001

# Network drive paths (default shown — override if your drives are mapped differently)
DRIVE_N=N:/
DRIVE_L=L:/

# Shared network folder where the database and thumbnails are stored.
# All users must point to the SAME path so they share data.
# If this path is unavailable the app falls back to a local folder (read the startup log).
SHARED_BASE=N:/_Assembilies_Library_Application

# Password required to delete records.
# Set a strong value — this is the only auth on destructive operations.
DELETE_PASSWORD=change_me_to_something_strong

# CORS origin — restrict to exactly the Electron app URL in production.
# Use * only during development.
ALLOWED_ORIGIN=http://127.0.0.1:3001

# Set to 'true' to enable verbose SQL and request logging.
# DEBUG=true
