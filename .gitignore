# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment / secrets (NEVER commit credentials) ─────────────────────────
.env
.env.local
.env.*.local
**/.env
**/.env.local

# ── SQLite databases (generated at runtime) ───────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
sessions.db

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
dist-electron/
release/
build/
**/dist/
**/client/dist/
out/
# Allow shell/build/ — it holds static Electron icon source assets, not build output
!shell/build/
!shell/build/**

# ── Electron-builder artifacts ────────────────────────────────────────────────
*.exe
*.dmg
*.AppImage
*.snap

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── OS / editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
.vs/
*.swp
*.swo

# ── Claude internal files ─────────────────────────────────────────────────────
.claude/

# ── Thumbnails (generated by Assemblies sync — large binary files) ────────────
**/thumbnails/*.jpg
**/thumbnails/*.png
**/thumbnails/*.jpeg

# ── Backup files ──────────────────────────────────────────────────────────────
backups/
*.bak

# ── Scratch / one-time scripts & local dev artefacts ─────────────────────────
scratch/
**/scratch/
check-sqlite.js
_icongen/
central/
server version/

# ── Sensitive documents (employee lists, contracts, patents) ──────────────────
*Employee List*
*employee list*
Patent/
**/Patent/

# ── Misc binaries & zips ──────────────────────────────────────────────────────
*.zip
GoogleDriveSetup.exe

# ── Test artifacts ────────────────────────────────────────────────────────────
playwright-report/
test-results/
coverage/

# ── Vite cache ────────────────────────────────────────────────────────────────
.vite/
**/.vite/

# ── Auto-updater sync state (runtime, not source) ─────────────────────────────
**/.update-sha
