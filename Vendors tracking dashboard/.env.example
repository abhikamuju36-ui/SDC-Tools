# ─────────────────────────────────────────────────────────────────────────────
# Vendor Tracker — Environment Configuration Template
# Copy this file to .env and fill in the values.
# The .env file is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (default: 4006 — assigned in SDC Tools shell)
PORT=4006

# ETO Database (SQL Server — on-premises)
ETO_HOST=your-server-here
ETO_DATABASE=SDC
ETO_USER=your-username
ETO_PASSWORD=your-password
ETO_DOMAIN=your-domain
ETO_PORT=1433

# Smartsheet (optional — for project sync)
SMARTSHEET_API_KEY=your-api-key-here
